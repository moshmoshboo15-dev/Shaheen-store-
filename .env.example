# ==============================================================================
# Shaheen Store — Environment Variables
# Copy to .env.local for local development and set in Cloudflare Pages + Supabase
# ==============================================================================

# --- Frontend Public Variables (Safe for Cloudflare Pages / Vite build) ---
# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=
# Supabase Public Anon Key (NEVER place service_role key in any VITE_ variable)
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile Site Key (use 1x00000000000000000000AA for local testing)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Payment Provider Public Checkout Link Base or Provider Name (e.g., lemon_squeezy, paddle, paytabs, manual)
VITE_PAYMENT_PROVIDER=manual_and_webhook
VITE_PAYMENT_CHECKOUT_URL=

# --- Backend Secrets (Set ONLY in Supabase Edge Function Secrets via `supabase secrets set`) ---
# NEVER prefix these with VITE_ or commit real values to Git!
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Optional Free VirusTotal API key (4 requests/min free tier) for queued binary hash/file scanning
VIRUSTOTAL_API_KEY=
# Initial platform owner email (used for admin promotion verification)
PLATFORM_OWNER_EMAIL=
